{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "data-ingest:contract/components/types/constr.schema.json",
    "title": "Constraints for String",
    "description": "Constaints for an String type",
    "type": "object",
    "properties": {
        "strip_whitespace": {
            "type": "boolean",
            "description": "Removes leading and trailing whitespace"
        },
        "to_lower": {
            "type": "boolean",
            "description": "Turns all characters to lowercase"
        },
        "min_length": {
            "type": "integer",
            "description": "Minimum length of the byte string"
        },
        "max_length": {
            "type": "integer",
            "description": "Maximum length of the byte string"
        },
        "strict": {
            "type": "boolean",
            "description": "Controls type coercion"
        },
        "regex": {
            "type": "string",
            "description": "Enforces string to match a specific regex pattern"
        }
    }
}