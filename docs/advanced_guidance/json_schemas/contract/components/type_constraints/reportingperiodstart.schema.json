{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "data-ingest:contract/components/types/reportingperiodstart.schema.json",
    "title": "Constraints for Reporting Period Start Date",
    "description": "Constaints for an ReportingPeriod (start) type",
    "type": "object",
    "properties": {
        "reporting_period_type": {
            "type": "string",
            "description": "Enforces date to be the start or end of a month.",
            "enum": [
                "start",
                "end"
            ]
        },
        "date_format": {
            "type": "string",
            "description": "Enforces date to match a specific format"
        }
    },
    "required": ["reporting_period_type"]
}